# Server Port
PORT=8080

# Neon Database URL (or PostgreSQL)
# Option 1: Standard Neon connection string (auto-parsed by DatabaseConfig):
# DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option 2: Explicit Spring datasource properties:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pms
SPRING_DATASOURCE_USERNAME=pms_user
SPRING_DATASOURCE_PASSWORD=pms_password

# JWT Authentication
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated frontend URLs, e.g. https://your-app.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MinIO / S3 Object Storage (Default local)
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=epms-attachments
